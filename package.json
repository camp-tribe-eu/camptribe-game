{
  "name": "camptribe-game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "CampLife — браузерний 2D-симулятор подорожей Європою",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "validate": "node scripts/validate-content.mjs --self-test && node scripts/validate-content.mjs --allow-missing-content",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run validate"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
